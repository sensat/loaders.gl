        "modules/kml/test"
      ],
      "@sensat/loaders-gl-las": [
        "modules/las/src"
      ],
      "@sensat/loaders-gl-las/test": [
        "modules/las/test"
      ],
      "@sensat/loaders-gl-lerc": [
        "modules/lerc/src"
      ],
      "@sensat/loaders-gl-lerc/test": [
        "modules/lerc/test"
      ],
      "@sensat/loaders-gl-mlt": [
        "modules/mlt/src"
      ],
      "@sensat/loaders-gl-mlt/test": [
        "modules/mlt/test"
      ],
      "@sensat/loaders-gl-mvt": [
        "modules/mvt/src"
      ],
      "@sensat/loaders-gl-mvt/test": [
        "modules/mvt/test"
      ],
      "@sensat/loaders-gl-netcdf": [
        "modules/netcdf/src"
      ],
      "@sensat/loaders-gl-netcdf/test": [
        "modules/netcdf/test"
      ],
      "@sensat/loaders-gl-obj": [
        "modules/obj/src"
      ],
      "@sensat/loaders-gl-obj/test": [
        "modules/obj/test"
      ],
      "@sensat/loaders-gl-parquet": [
        "modules/parquet/src"
      ],
      "@sensat/loaders-gl-parquet/*": [
