// This is a base TS config for the entire mono repo, mainly for linting
{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "strict": true,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    // This must be specified if "paths" is.
    "baseUrl": ".",
    "paths": {
      // Supoort modules
      "@sensat/loaders-gl-schema": [
        "modules/schema/src"
      ],
      "@sensat/loaders-gl-schema/test": [
        "modules/schema/test"
      ],
      "@sensat/loaders-gl-schema-utils": [
        "modules/schema-utils/src"
      ],
      "@sensat/loaders-gl-schema-utils/test": [
        "modules/schema-utils/test"
      ],
      "@sensat/loaders-gl-worker-utils": [
        "modules/worker-utils/src"
      ],
      "@sensat/loaders-gl-worker-utils/test": [
        "modules/worker-utils/test"
      ],
      "@sensat/loaders-gl-loader-utils": [
        "modules/loader-utils/src"
      ],
      "@sensat/loaders-gl-loader-utils/test": [
        "modules/loader-utils/test"
      ],
      "@sensat/loaders-gl-polyfills": [
        "modules/polyfills/src"
      ],
      "@sensat/loaders-gl-polyfills/test": [
        "modules/polyfills/test"
      ],
      "@sensat/loaders-gl-math": [
        "modules/math/src"
      ],
      "@sensat/loaders-gl-math/test": [
        "modules/math/test"
      ],
      "@sensat/loaders-gl-geoarrow": [
        "modules/geoarrow/src"
      ],
      "@sensat/loaders-gl-geoarrow/test": [
        "modules/geoarrow/test"
      ],
      "@sensat/loaders-gl-core": [
        "modules/core/src"
      ],
      "@sensat/loaders-gl-core/lib/*": [
        "modules/core/src/lib/*"
      ],
      "@sensat/loaders-gl-core/test": [
        "modules/core/test"
      ],
      "@sensat/loaders-gl-compression": [
        "modules/compression/src"
      ],
      "@sensat/loaders-gl-compression/test": [
        "modules/compression/test"
      ],
      "@sensat/loaders-gl-crypto": [
        "modules/crypto/src"
      ],
      "@sensat/loaders-gl-crypto/test": [
        "modules/crypto/test"
      ],
      "@sensat/loaders-gl-3d-tiles": [
        "modules/3d-tiles/src"
