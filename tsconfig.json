      "@sensat/loaders-gl-3d-tiles/test": [
        "modules/3d-tiles/test"
      ],
      "@sensat/loaders-gl-arrow": [
        "modules/arrow/src"
      ],
      "@sensat/loaders-gl-arrow/test": [
        "modules/arrow/test"
      ],
      "@sensat/loaders-gl-csv": [
        "modules/csv/src"
      ],
      "@sensat/loaders-gl-csv/test": [
        "modules/csv/test"
      ],
      "@sensat/loaders-gl-draco": [
        "modules/draco/src"
      ],
      "@sensat/loaders-gl-draco/test": [
        "modules/draco/test"
      ],
      "@sensat/loaders-gl-excel": [
        "modules/excel/src"
      ],
      "@sensat/loaders-gl-excel/test": [
        "modules/excel/test"
      ],
      "@sensat/loaders-gl-flatgeobuf": [
        "modules/flatgeobuf/src"
      ],
