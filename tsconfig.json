      ],
      "@sensat/loaders-gl-tile-converter": [
        "apps/tile-converter/src"
      ],
      "@sensat/loaders-gl-tile-converter/test": [
        "apps/tile-converter/test"
      ],
      "@sensat/loaders-gl-terrain": [
        "modules/terrain/src"
      ],
      "@sensat/loaders-gl-terrain/test": [
        "modules/terrain/test"
      ],
      "@sensat/loaders-gl-textures": [
        "modules/textures/src"
      ],
      "@sensat/loaders-gl-textures/test": [
        "modules/textures/test"
      ],
      "@sensat/loaders-gl-video": [
        "modules/video/src"
      ],
      "@sensat/loaders-gl-video/test": [
        "modules/video/test"
      ],
      "@sensat/loaders-gl-wkt": [
        "modules/wkt/src"
      ],
      "@sensat/loaders-gl-wkt/test": [
        "modules/wkt/test"
      ],
      "@sensat/loaders-gl-wms": [
        "modules/wms/src"
      ],
      "@sensat/loaders-gl-wms/test": [
        "modules/wms/test"
      ],
      "@sensat/loaders-gl-xml": [
        "modules/xml/src"
      ],
      "@sensat/loaders-gl-xml/test": [
        "modules/xml/test"
      ],
      "@loaders.gl/zarr": [
        "modules/zarr/src"
      ],
      "@loaders.gl/zarr/test": [
        "modules/zarr/test"
      ],
      "@sensat/loaders-gl-zip": [
        "modules/zip/src"
      ],
      "@sensat/loaders-gl-zip/test": [
        "modules/zip/test"
      ],
      "test": [
        "test"
      ]
    },
    "plugins": [
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-version-inline"
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [
          ".js"
        ],
        "after": true
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [
          ".js"
        ],
        "afterDeclarations": true
      }
    ],
  },
  "exclude": [
    "modules/**/src/libs",
    "modules/*/bin/**",
    "modules/*/dist/**",
    "modules/**/wip/**",
    "examples",
    "coverage",
    "arrowjs",
    "website",
    "website-gatsby"
  ]
}