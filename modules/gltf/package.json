{
  "name": "@sensat/loaders-gl-gltf",
  "version": "4.4.6-sensat.0",
  "description": "Framework-independent loader for the glTF format",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sensat/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "mesh",
    "point cloud",
    "GLB",
    "glTF"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@math.gl/core": "^4.1.0",
    "@sensat/loaders-gl-draco": "4.4.6-sensat.0",
    "@sensat/loaders-gl-images": "4.4.6-sensat.0",
    "@sensat/loaders-gl-loader-utils": "4.4.6-sensat.0",
    "@sensat/loaders-gl-schema": "4.4.6-sensat.0",
    "@sensat/loaders-gl-textures": "4.4.6-sensat.0",
    "meshoptimizer": "^1.2.0"
  },
  "peerDependencies": {
    "@sensat/loaders-gl-core": "4.4.6-sensat.0"
  }
}
