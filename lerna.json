{
  "lerna": "2.0.0",
  "version": "4.4.6-sensat.0",
  "npmClient": "yarn",
  "exact": true,
  "packages": [
    "modules/*",
    "apps/*"
  ],
  "command": {
    "publish": {
      "ignoreChanges": [
        "test",
        "*.md"
      ]
    },
    "bootstrap": {}
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
